[Unit]
Description=StonePi Radio
After=network-online.target stonepi-auth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stonepi-radio
Group=stonepi-radio
EnvironmentFile=/etc/stonepi/stonepi.env
EnvironmentFile=-/etc/stonepi/radio.env
WorkingDirectory=/opt/stonepi/apps/radio
ExecStart=/opt/stonepi/apps/radio/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=300M

[Install]
WantedBy=multi-user.target
