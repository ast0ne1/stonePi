# Auto-start StonePi backup when a filesystem labelled STONEPI-BACKUP appears.
# Installer copies this to /etc/udev/rules.d/99-stonepi-backup.rules
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_LABEL}=="STONEPI-BACKUP", TAG+="systemd", ENV{SYSTEMD_WANTS}="stonepi-backup.service"
