# Loopback by default (StonePi serves FileServe through nginx). Solo installs that
# need direct LAN access must set HOST=0.0.0.0 here explicitly.
HOST=127.0.0.1
PORT=8081
DATABASE_URL=sqlite:///./data/fileserve.db
PUBLIC_BASE_URL=http://127.0.0.1:8081
DEVICE_HOSTNAME=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=

INSTANCE_NAME=
GITHUB_REPO=

STONEPI_SESSION_SECRET=
STONEPI_PREFIX=
STONEPI_AUTH_URL=
STONEPI_APP_ID=fileserve
STONEPI_PUBLIC_ORIGIN=
