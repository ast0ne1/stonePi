[Unit]
Description=StonePi PriceScout
After=network-online.target stonepi-auth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stonepi-prices
Group=stonepi-prices
EnvironmentFile=/etc/stonepi/stonepi.env
EnvironmentFile=-/etc/stonepi/pricescout.env
WorkingDirectory=/opt/stonepi/apps/pricescout
ExecStart=/opt/stonepi/apps/pricescout/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=400M

[Install]
WantedBy=multi-user.target
