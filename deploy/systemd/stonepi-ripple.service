[Unit]
Description=StonePi Ripple
After=network-online.target stonepi-auth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stonepi-ripple
Group=stonepi-ripple
EnvironmentFile=/etc/stonepi/stonepi.env
EnvironmentFile=-/etc/stonepi/ripple.env
WorkingDirectory=/opt/stonepi/apps/ripple
ExecStart=/opt/stonepi/apps/ripple/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
# Photos are processed one at a time at no more than 4096 px (JPEGs decode at a reduced
# size), so this leaves plenty of room; it keeps an odd upload from crowding the other apps.
MemoryMax=384M

[Install]
WantedBy=multi-user.target
