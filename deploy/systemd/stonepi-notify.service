[Unit]
Description=StonePi Notifications
After=network-online.target stonepi-auth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stonepi-notify
Group=stonepi-notify
EnvironmentFile=/etc/stonepi/stonepi.env
EnvironmentFile=-/etc/stonepi/notify.env
WorkingDirectory=/opt/stonepi/apps/notify
ExecStart=/opt/stonepi/apps/notify/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
# Notify → Displays → Car Thing switches the panel via the root helper
# (/usr/local/sbin/stonepi-carthing-helper) over sudoers. NoNewPrivileges would block sudo.
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
