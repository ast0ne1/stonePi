[Unit]
Description=StonePi SportGuide
After=network-online.target stonepi-auth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stonepi-sport
Group=stonepi-sport
EnvironmentFile=/etc/stonepi/stonepi.env
EnvironmentFile=-/etc/stonepi/sportguide.env
Environment=HOME=/opt/stonepi
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/stonepi/.cache/ms-playwright
WorkingDirectory=/opt/stonepi/apps/sportguide
ExecStart=/opt/stonepi/apps/sportguide/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=400M

[Install]
WantedBy=multi-user.target
