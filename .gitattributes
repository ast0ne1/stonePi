# Shipped files are LF on every checkout, whatever core.autocrlf says: a CRLF install.sh
# fails on the Pi (`set: pipefail: invalid option`). Releases also build from an LF export
# (deploy/RELEASE.md section 6).
* text=auto eol=lf

*.sh          text eol=lf
*.py          text eol=lf
*.service     text eol=lf
*.target      text eol=lf
*.timer       text eol=lf
*.rules       text eol=lf
*.conf        text eol=lf
*.nft         text eol=lf
*.env.example text eol=lf
.env.example  text eol=lf

# Windows-only helpers
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.gif    binary
*.webp   binary
*.zip    binary
*.gz     binary
*.tar    binary
*.zim    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
*.epub   binary
*.sqlite binary
*.db     binary
